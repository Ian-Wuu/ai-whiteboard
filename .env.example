# Copy to .env and fill in the values; do not overwrite an existing configuration.
# 复制为 .env 后填写；不要覆盖已有配置。
# Server-side secrets only. Never commit them or use a VITE_ prefix.
# 永久密钥只用于服务端，禁止提交到 Git 或使用 VITE_ 前缀。
DASHSCOPE_API_KEY=
# Beijing workspace ID; must match the workspace that owns the API key.
# 北京地域的业务空间 ID，必须与 API Key 所属空间一致。
DASHSCOPE_WORKSPACE_ID=
# Models must be available in your workspace. API calls incur Alibaba Cloud charges.
# 模型名称需在你的业务空间内可用；调用产生百炼费用。
DASHSCOPE_MODEL=qwen-audio-3.0-realtime-flash
DASHSCOPE_IMAGE_SEARCH_MODEL=qwen3.6-flash
# If changed, also update the /api proxy in vite.config.ts.
# 如修改端口，也要修改 vite.config.ts 的 /api 代理。
PORT=8787
